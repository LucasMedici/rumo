NODE_ENV=development
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# Supabase → Connect → "Session pooler" (port 5432). Replace [PASSWORD] with the database password.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Supabase project URL (used to verify access tokens via its public JWKS)
SUPABASE_URL=https://[PROJECT-REF].supabase.co

# Max requests per IP per minute (all routes)
RATE_LIMIT_MAX=100
# Set to true ONLY behind a reverse proxy/load balancer (production); otherwise IPs can be spoofed
TRUST_PROXY=false

# Optional: GitHub token without scopes (raises the GitHub API limit from 60 to 5,000 requests/hour)
# GITHUB_TOKEN=
